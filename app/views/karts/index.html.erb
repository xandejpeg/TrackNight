<% content_for :title, "Karts — TrackNight" %>
<% list_view = params[:view] == "lista" %>
<% details_on = params[:details] == "1" %>

<div class="mb-5">
  <p class="kicker mb-1">Máquinas</p>
  <h1 class="text-3xl font-black tracking-tight">Karts pilotados</h1>
  <p class="text-sm text-mute mt-1">Cada kart rental é uma loteria — estes foram os números que você já pilotou.</p>
</div>

<div class="mb-8 flex flex-col gap-3">
  <%= render "shared/filters" %>
  <div class="flex items-center gap-2">
    <span class="filter-label">Visualização</span>
    <div class="filter-group">
      <%= link_to "▦ Grade", url_for(request.query_parameters.merge(view: nil)),
          class: "filter-pill #{'filter-pill-active' unless list_view}" %>
      <%= link_to "≡ Lista", url_for(request.query_parameters.merge(view: "lista")),
          class: "filter-pill #{'filter-pill-active' if list_view}" %>
    </div>
  </div>
  <% unless list_view %>
    <div class="flex items-center gap-2">
      <span class="filter-label">Detalhes nos cards</span>
      <%= link_to url_for(request.query_parameters.merge(details: details_on ? nil : "1")),
            class: "inline-flex items-center gap-2 text-[11px] font-semibold #{details_on ? 'text-white' : 'text-mute'}",
            role: "switch", aria: { checked: details_on, label: "Exibir detalhes dos karts" } do %>
        <span class="toggle-track <%= 'toggle-on' if details_on %>"><span class="toggle-thumb"></span></span>
        <span><%= details_on ? "Ligados" : "Desligados" %></span>
      <% end %>
    </div>
  <% end %>
</div>

<% if @kart_stats.empty? %>
  <div class="glass p-12 text-center text-sm text-mute">Nenhum kart registrado neste filtro.</div>
<% else %>
  <% best = @kart_stats.find { |k| k[:best_run] } || @kart_stats.first %>
  <% most_used = @kart_stats.max_by { |k| k[:uses] } %>
  <% fastest_trap = @kart_stats.select { |k| k[:max_speed] }.max_by { |k| k[:max_speed] } %>

  <!-- Resumo da frota -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <% if best[:best_run] %>
      <%= link_to race_session_path(best[:best_run][:session]), class: "glass glass-hover p-5 block group", aria: { label: "Abrir corrida do melhor kart" } do %>
        <p class="kicker text-gold">🥇 Melhor kart</p>
        <p class="stat-value text-4xl mt-2">#<%= best[:number] %></p>
        <p class="text-[11px] text-mute mt-2 flex items-center gap-2">melhor volta <span class="chrono font-bold text-white"><%= lap(best[:best_ms]) %></span><span class="ml-auto text-race-glow group-hover:translate-x-0.5 transition-transform">→</span></p>
      <% end %>
    <% else %>
      <div class="glass p-5">
        <p class="kicker text-gold">🥇 Melhor kart</p>
        <p class="stat-value text-4xl mt-2">#<%= best[:number] %></p>
        <p class="text-[11px] text-mute mt-2">melhor volta —</p>
      </div>
    <% end %>
    <%= link_to url_for(request.query_parameters.merge(view: list_view ? nil : "lista")),
          class: "glass glass-hover p-5 block group",
          aria: { label: list_view ? "Mudar para visualização em cards" : "Mudar para visualização em lista" } do %>
      <p class="kicker">Karts diferentes</p>
      <p class="stat-value text-4xl mt-2"><%= @kart_stats.size %></p>
      <p class="text-[11px] text-mute mt-2 flex items-center gap-2"><%= @kart_stats.sum { |k| k[:uses] } %> corridas · <%= list_view ? "ver cards" : "ver lista" %><span class="ml-auto text-race-glow group-hover:translate-x-0.5 transition-transform">→</span></p>
    <% end %>
    <div class="glass p-5">
      <p class="kicker text-accent">Mais usado</p>
      <p class="stat-value text-4xl mt-2">#<%= most_used[:number] %></p>
      <p class="text-[11px] text-mute mt-2"><%= most_used[:uses] %> corrida(s)</p>
    </div>
    <% if fastest_trap&.dig(:fastest_run) %>
      <%= link_to race_session_path(fastest_trap[:fastest_run][:session]), class: "glass glass-hover p-5 block group", aria: { label: "Abrir corrida da maior velocidade" } do %>
        <p class="kicker text-mint">Maior velocidade</p>
        <p class="stat-value text-4xl mt-2"><%= fastest_trap[:max_speed] %><span class="text-lg text-mute"> km/h</span></p>
        <p class="text-[11px] text-mute mt-2 flex items-center gap-2">kart #<%= fastest_trap[:number] %><span class="ml-auto text-race-glow group-hover:translate-x-0.5 transition-transform">→</span></p>
      <% end %>
    <% else %>
      <div class="glass p-5">
        <p class="kicker text-mint">Maior velocidade</p>
        <p class="stat-value text-4xl mt-2">—</p>
        <p class="text-[11px] text-mute mt-2">sem speed trap</p>
      </div>
    <% end %>
  </div>

  <% if list_view %>
    <!-- Modo lista: todos os karts de uma vez, direto ao ponto -->
    <div class="glass p-6 overflow-x-auto">
      <table class="w-full table-race">
        <thead>
          <tr><th></th><th>Kart</th><th>Corridas</th><th>Melhor volta</th><th>Média</th><th>Vel. máx</th><th>Melhor pos</th><th>Voltas</th><th>Última corrida</th></tr>
        </thead>
        <tbody>
          <% @kart_stats.each_with_index do |k, i| %>
            <% last_run = k[:runs].max_by { |r| r[:session].started_at || Time.at(0) } %>
            <tr class="hover:bg-white/[0.03] transition-colors">
              <td class="w-16"><%= image_tag "rental_kart_4_strokes.png", alt: "Kart rental 4 tempos", class: "w-14 h-auto opacity-90 #{'drop-shadow-[0_0_8px_rgba(255,209,102,0.5)]' if i.zero?}" %></td>
              <td class="chrono font-black text-lg"><%= i.zero? ? "🥇" : "" %> #<%= k[:number] %></td>
              <td class="chrono"><%= k[:uses] %></td>
              <td class="chrono font-bold">
                <% if k[:best_run] %>
                  <%= link_to lap(k[:best_ms]), race_session_path(k[:best_run][:session]), class: "text-race-glow hover:underline", aria: { label: "Abrir corrida da melhor volta do kart #{k[:number]}" } %>
                <% else %>—<% end %>
              </td>
              <td class="chrono text-mute"><%= lap(k[:avg_ms]) %></td>
              <td class="chrono">
                <% if k[:fastest_run] %>
                  <%= link_to "#{k[:max_speed]} km/h", race_session_path(k[:fastest_run][:session]), class: "text-race-glow hover:underline", aria: { label: "Abrir corrida da velocidade máxima do kart #{k[:number]}" } %>
                <% else %>—<% end %>
              </td>
              <td class="chrono">P<%= k[:best_position] || "—" %></td>
              <td class="chrono text-mute"><%= k[:total_laps].positive? ? k[:total_laps] : "—" %></td>
              <td>
                <% if last_run %>
                  <%= link_to race_session_path(last_run[:session]), class: "chrono text-[11px] text-race-glow hover:underline" do %>
                    <%= last_run[:session].started_at ? last_run[:session].started_at.strftime("%d/%m/%y") : last_run[:session].title %>
                  <% end %>
                <% else %>—<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif details_on %>
    <!-- Cards detalhados: todas as estatísticas e corridas de cada kart -->
    <div class="grid lg:grid-cols-2 gap-4">
      <% @kart_stats.each_with_index do |k, i| %>
        <div class="glass glass-hover p-6 <%= "border-gold/40" if i.zero? %>">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <p class="kicker"><%= i.zero? ? "🥇 o mais rápido até agora" : "kart" %></p>
              <p class="stat-value text-5xl font-black mt-1">#<%= k[:number] %></p>
            </div>
            <%= image_tag "rental_kart_4_strokes.png", alt: "Kart rental 4 tempos número #{k[:number]}", class: "w-40 h-auto -mt-1 opacity-100 drop-shadow-[0_10px_18px_rgba(0,0,0,0.6)] #{'drop-shadow-[0_0_16px_rgba(255,209,102,0.35)]' if i.zero?}" %>
            <div class="text-right">
              <p class="text-[10px] uppercase tracking-widest text-mute">Corridas</p>
              <p class="stat-value text-3xl"><%= k[:uses] %></p>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <% if k[:best_run] %>
              <%= link_to race_session_path(k[:best_run][:session]), class: "rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2 hover:border-race/40 transition-colors", aria: { label: "Abrir corrida da melhor volta do kart #{k[:number]}" } do %>
                <p class="text-[9px] uppercase tracking-widest text-mute">Melhor volta</p>
                <p class="chrono font-bold"><%= lap(k[:best_ms]) %></p>
              <% end %>
            <% else %>
              <div class="rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2">
                <p class="text-[9px] uppercase tracking-widest text-mute">Melhor volta</p>
                <p class="chrono font-bold">—</p>
              </div>
            <% end %>
            <div class="rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2">
              <p class="text-[9px] uppercase tracking-widest text-mute">Média</p>
              <p class="chrono"><%= lap(k[:avg_ms]) %></p>
            </div>
            <% if k[:fastest_run] %>
              <%= link_to race_session_path(k[:fastest_run][:session]), class: "rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2 hover:border-race/40 transition-colors", aria: { label: "Abrir corrida da velocidade máxima do kart #{k[:number]}" } do %>
                <p class="text-[9px] uppercase tracking-widest text-mute">Vel. máx</p>
                <p class="chrono"><%= k[:max_speed] %> km/h</p>
              <% end %>
            <% else %>
              <div class="rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2">
                <p class="text-[9px] uppercase tracking-widest text-mute">Vel. máx</p>
                <p class="chrono">—</p>
              </div>
            <% end %>
            <div class="rounded-lg bg-white/[0.03] border border-white/5 px-3 py-2">
              <p class="text-[9px] uppercase tracking-widest text-mute">Melhor pos</p>
              <p class="chrono">P<%= k[:best_position] || "—" %></p>
            </div>
          </div>

          <p class="text-[10px] uppercase tracking-widest text-mute mb-2">Corridas com esse kart</p>
          <div class="flex flex-col gap-2">
            <% k[:runs].each do |run| %>
              <% s = run[:session] %>
              <%= link_to race_session_path(s), class: "flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg bg-white/[0.02] border border-white/5 px-3 py-2 hover:border-race/40 transition-colors" do %>
                <span class="chrono text-[11px] text-mute"><%= s.started_at ? s.started_at.strftime("%d/%m/%y %H:%M") : "Data pendente" %></span>
                <span class="text-[12px] font-semibold"><%= s.title %></span>
                <%= weather_chips(s) %>
                <span class="ml-auto flex items-center gap-3">
                  <span class="chrono text-[12px] font-bold"><%= lap(run[:best_ms]) %></span>
                  <span class="chrono text-[11px] text-mute"><%= run[:speed] ? "#{run[:speed]} km/h" : "—" %></span>
                  <span class="chrono text-[11px] <%= run[:position] && run[:position] <= 3 ? 'text-gold' : 'text-mute' %>">P<%= run[:position] || "—" %></span>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Padrão: karts grandes, apenas número, melhor volta e velocidade máxima -->
    <div class="grid lg:grid-cols-2 gap-5">
      <% @kart_stats.each_with_index do |k, i| %>
        <article class="glass glass-hover p-6 overflow-hidden <%= "border-gold/40" if i.zero? %>">
          <p class="stat-value text-6xl font-black">#<%= k[:number] %></p>
          <%= image_tag "rental_kart_4_strokes.png", alt: "Kart rental 4 tempos número #{k[:number]}", class: "w-full h-48 sm:h-56 object-contain opacity-100 scale-110 drop-shadow-[0_16px_24px_rgba(0,0,0,0.7)] #{'drop-shadow-[0_0_22px_rgba(255,209,102,0.38)]' if i.zero?}" %>
          <div class="grid grid-cols-2 gap-3 mt-2">
            <% if k[:best_run] %>
              <%= link_to race_session_path(k[:best_run][:session]), class: "rounded-xl bg-white/[0.035] border border-white/5 px-4 py-3 hover:border-race/40 transition-colors group", aria: { label: "Abrir corrida da melhor volta do kart #{k[:number]}" } do %>
                <p class="text-[9px] uppercase tracking-widest text-mute">Melhor volta</p>
                <p class="stat-value chrono text-xl sm:text-2xl font-bold mt-1"><%= lap(k[:best_ms]) %></p>
                <p class="text-[9px] text-race-glow mt-1">Ver corrida →</p>
              <% end %>
            <% else %>
              <div class="rounded-xl bg-white/[0.035] border border-white/5 px-4 py-3">
                <p class="text-[9px] uppercase tracking-widest text-mute">Melhor volta</p>
                <p class="stat-value chrono text-xl sm:text-2xl font-bold mt-1">—</p>
              </div>
            <% end %>
            <% if k[:fastest_run] %>
              <%= link_to race_session_path(k[:fastest_run][:session]), class: "rounded-xl bg-white/[0.035] border border-white/5 px-4 py-3 hover:border-race/40 transition-colors group", aria: { label: "Abrir corrida da velocidade máxima do kart #{k[:number]}" } do %>
                <p class="text-[9px] uppercase tracking-widest text-mute">Velocidade máxima</p>
                <p class="stat-value chrono text-xl sm:text-2xl font-bold mt-1"><%= k[:max_speed] %> <span class="text-sm">km/h</span></p>
                <p class="text-[9px] text-race-glow mt-1">Ver corrida →</p>
              <% end %>
            <% else %>
              <div class="rounded-xl bg-white/[0.035] border border-white/5 px-4 py-3">
                <p class="text-[9px] uppercase tracking-widest text-mute">Velocidade máxima</p>
                <p class="stat-value chrono text-xl sm:text-2xl font-bold mt-1">—</p>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
<% end %>
