<!DOCTYPE html>
<html lang="pt-BR" class="dark">
  <head>
    <title><%= content_for(:title) || "TrackNight — Análise de desempenho em pista" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="TrackNight: importe suas folhas de resultado e analise seu desempenho em pista — melhores voltas, setores, evolução e ranking. KGV Circuito 101.">
    <meta name="theme-color" content="#060608">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="speed-lines bg-carbon text-white antialiased">
    <header class="fixed top-0 inset-x-0 z-50">
      <div class="glass !rounded-none border-x-0 border-t-0 backdrop-blur-2xl">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center h-16">
          <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
            <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-race to-[#7a0a06] grid place-items-center font-black italic text-white shadow-[0_0_18px_rgba(225,6,0,0.5)]">TN</span>
            <span class="font-black tracking-tight text-[15px]">TRACK<span class="text-race">NIGHT</span></span>
          <% end %>
          <nav class="ml-auto flex items-center gap-2">
            <%= link_to "Entrar", login_path, class: "btn-ghost !text-[12px]" %>
            <%= link_to "Criar conta", signup_path, class: "btn-race !text-[12px] !py-2" %>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 flex flex-wrap items-center gap-4 text-[12px] text-mute">
        <span class="font-black tracking-tight text-white/80">TRACK<span class="text-race">NIGHT</span></span>
        <span>·</span>
        <span>Análise de desempenho em pista</span>
        <span class="ml-auto">KGV — Circuito 101</span>
      </div>
    </footer>
  </body>
</html>
