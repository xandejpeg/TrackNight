<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { font-family: system-ui, sans-serif; background: #060608; color: #e8e8ee; margin: 0; padding: 24px; }
      .card { background: #0e0e12; border: 1px solid #26262e; border-radius: 12px; padding: 28px; max-width: 480px; margin: 0 auto; }
      h1 { font-size: 20px; margin: 0 0 16px; }
      .brand { font-weight: 900; letter-spacing: -0.02em; }
      .brand span { color: #e10600; }
      p { color: #8b8b96; font-size: 14px; line-height: 1.6; margin: 0 0 12px; }
      .btn { display: inline-block; background: linear-gradient(135deg, #e10600, #99110d); color: #fff; text-decoration: none; font-weight: 700; font-size: 13px; letter-spacing: 0.05em; text-transform: uppercase; padding: 12px 24px; border-radius: 10px; margin-top: 8px; }
    </style>
  </head>
  <body>
    <div class="card">
      <%= yield %>
    </div>
  </body>
</html>
